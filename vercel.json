{
  "functions": {
    "api/*.js": { "includeFiles": "knowledge/chunks.json", "maxDuration": 60 }
  },
  "redirects": [
    { "source": "/(knowledge/.*|scripts/.*|eval/.*|test/.*|server\\.js|llm\\.config\\.js|ROADMAP\\.md|DATA_ISSUES\\.md|\\.github/.*|package\\.json|package-lock\\.json|vercel\\.json|README\\.md|\\.env.*|lib/.*)", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ]
}
