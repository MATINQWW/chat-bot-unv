    "test:load:local": "node scripts/load-test-local.cjs",
    "test:admin-auth": "node test/admin-auth.js",
    "test:admin-ui": "node test/admin-ui.js"
  },
  "dependencies": {
    "@upstash/vector": "1.2.3",
    "argon2": "^0.45.2",
    "mysql2": "3.24.6",
    "openai": "4.104.0",
    "pdf-parse": "1.1.1"
  }
}
