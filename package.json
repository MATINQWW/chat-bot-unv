{
  "name": "chat-bot-unv",
  "version": "1.6.13",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "test": "node test/smoke.js && node test/answer-policy.js",
    "ingest": "node scripts/ingest.js",
    "search": "node scripts/search.js",
    "eval": "node scripts/eval.js",
    "test:mysql": "node test/mysql.js",
    "test:server": "node test/server.js",
    "test:all": "npm test && npm run test:server && npm run test:security && npm run test:admin-auth && npm run test:admin-ui && npm run eval -- --min 90",
