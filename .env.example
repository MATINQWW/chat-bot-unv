# ─── مدل زبانی (OpenAI-compatible) ───
ICP_API_KEY=
ICP_MODEL=icp-chat
# ICP_VISION_MODEL=
# ICP_BASE_URL=https://irancopilot.com/studio/pro/v1
# ICP_KNOWLEDGE_CHARS=1800
# ICP_MAX_TOKENS=800

# ─── امنیت ───
CHAT_SIGNING_SECRET=        # رشتهٔ تصادفی ≥ ۱۶ نویسه
# ADMIN_TOKEN=               # برای /api/admin (≥ ۱۶ نویسه)
# ALLOWED_ORIGINS=https://example.com

# ─── Upstash Redis (rate-limit + حافظهٔ یادگیری) ───
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Upstash Vector (پایگاه دانش) — ایندکس Hybrid ───
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
# VECTOR_NAMESPACE=          # خالی = namespace پیش‌فرض
# VECTOR_TOPK=5
# VECTOR_KEEP=3
# VECTOR_TIMEOUT_MS=2500
# FAQ_SIM=0.6                # حداقل شباهت برای پاسخ مستقیم FAQ (۰ تا ۱)
# SEMCACHE=1                 # 0 = خاموش کردن کش معنایی
# SEMCACHE_SIM=0.92          # حداقل شباهت معنایی (dense) برای استفاده از پاسخ ذخیره‌شده؛ با آمار پنل تنظیم کنید
# ICP_STREAM=1               # 0 = خاموش کردن پاسخ جریانی (اگر سرویس مدل stream را پشتیبانی نکند)

# ─── درخواست تماس ───
# LEAD_WEBHOOK_URL=          # اختیاری: هر درخواست به‌صورت JSON به این آدرس POST می‌شود

# ─── گفتار به متن (اختیاری) ───
# TRANSCRIBE_API_URL=
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=
